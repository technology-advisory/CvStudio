{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cvstudio",
  "main": "src/worker.js",

  "workers_dev": false,
  "preview_urls": false,

  "compatibility_date": "2026-08-06",

  "dev": {
    "port": 10060
  },

  "assets": {
    "directory": ".dev-static",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "browser": {
    "binding": "BROWSER"
  },

  "ratelimits": [
    {
      "name": "SEND_RATE_LIMITER",
      "namespace_id": "13001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "PDF_RATE_LIMITER",
      "namespace_id": "13002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-studio-db",
      "database_id": "f17a8747-b26c-4af0-974d-b9bf17c23729",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "opentrust-cv-private"
    }
  ],

  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },

  "vars": {
    "APP_NAME": "OpenTrust CV Studio",
    "RETENTION_DAYS": "90",
    "PUBLIC_BASE_URL": "https://cvstudio.opentrust.group",

    "SMTP_HOST": "smtppro.zoho.eu",
    "SMTP_PORT": "587",
    "SMTP_SECURITY": "starttls",

    "ACCESS_TEAM_DOMAIN": "green-hall-6a70.cloudflareaccess.com",
	"ACCESS_AUD": "1331f13bfbda5bd800fe809969530746eb23b325d8e327eb7cafa1921d70038b"
  }

  // Defensa en profundidad:
  // Cloudflare Access en perímetro + validación JWT en el Worker.
  //
  // Sustituir:
  // ACCESS_TEAM_DOMAIN
  // ACCESS_AUD
  //
  // por los valores reales de Cloudflare Zero Trust.
  //
  // Los secretos SMTP se configuran como secrets del Worker
  // y nunca se versionan.
}