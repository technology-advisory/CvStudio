{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "opentrust-cv-studio",

  "main": "src/worker.js",

  "compatibility_date": "2026-08-06",

  "dev": {
    "port": 10060
  },

  "assets": {
    "directory": ".dev-static",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "browser": {
    "binding": "BROWSER"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-studio-db",
      "database_id": "f17a8747-b26c-4af0-974d-b9bf17c23729",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "opentrust-cv-private"
    }
  ],

  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },

  "vars": {
    "APP_NAME": "OpenTrust CV Studio",
    "RETENTION_DAYS": "90",
    "PUBLIC_BASE_URL": "https://cvstudio.opentrust.group",
    "SMTP_HOST": "smtppro.zoho.eu",
    "SMTP_PORT": "587",
    "SMTP_SECURITY": "starttls"
  }

  // No hay autenticación interna.
  // La protección de producción se realizará mediante Cloudflare Access.
  //
  // Los secretos SMTP se configuran como secrets del Worker y nunca
  // se versionan en GitHub.
}
