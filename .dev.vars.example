# CV Studio · variables locales (NO subir .dev.vars a Git)
# Copia este archivo como .dev.vars y sustituye solo los valores sensibles.

# Zoho Mail SMTP directo (misma configuración lógica que producción)
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=usuario@tu-dominio.example
SMTP_PASSWORD=CAMBIAR_POR_PASSWORD_O_APP_PASSWORD_DE_ZOHO
SMTP_FROM=usuario@tu-dominio.example
SMTP_FROM_NAME=Miguel Ángel Carriazo · OpenTrust Group
SMTP_REPLY_TO=usuario@tu-dominio.example
ALERT_EMAIL_TO=usuario@tu-dominio.example

# Seguridad Cloudflare Access (PRO; opcional en local)
ADMIN_EMAILS=tu-email-autorizado@example.com
ACCESS_TEAM_DOMAIN=tu-equipo.cloudflareaccess.com
ACCESS_AUD=tu-audience-tag-de-access
