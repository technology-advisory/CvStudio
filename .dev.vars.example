REQUEST_TTL_MINUTES=1440
TOKEN_TTL_MINUTES=30

# Días que se conservan IP/ubicación/navegador de las descargas antes de purgarse
RETENTION_DAYS=90

# Zoho Mail SMTP
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=587
SMTP_SECURITY=starttls
